      "folder": "Fahrzeugtechnik",
      "rules": [
        {"file": "klausur|^FP_", "to": "Klausurvorbereitung"},
        {"file": "^skript", "to": "Vorlesung"}
      ]
    }
  },
  "rules": [],
  "ignore": [
    {"file": "^Tools\\.zip\\.\\d+$", "ignore": true}
